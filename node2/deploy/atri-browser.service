[Unit]
Description=Atri Browser read-only peripheral
Wants=network-online.target wg-quick@wg0.service
After=network-online.target wg-quick@wg0.service

[Service]
Type=simple
User=atri-browser
Group=atri-browser
WorkingDirectory=/opt/atri-browser
Environment=ATRI_BROWSER_CONFIG=/etc/atri-browser/config.json
ExecStart=/usr/bin/node /opt/atri-browser/server.js
Restart=on-failure
RestartSec=5
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atri-browser
StateDirectory=atri-browser
Environment=HOME=/var/lib/atri-browser
NoNewPrivileges=true
KillMode=mixed
TimeoutStopSec=20
TasksMax=256
MemoryMax=2G
CPUQuota=150%

[Install]
WantedBy=multi-user.target
